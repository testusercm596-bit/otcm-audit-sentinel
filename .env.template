# PostgreSQL Database Configuration
POSTGRES_USER=otcm_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=otcm_audit_sentinel

# Database Connection URL (for application)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Content Manager Configuration
CM_BASE_URL=https://your-content-manager.example.com
CM_USERNAME=your_username
CM_PASSWORD=your_password
CM_DOMAIN=YOUR_DOMAIN

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7

# Sentinel Agent Configuration
SENTINEL_SENSITIVITY=0.7
SENTINEL_REALTIME=true

# Hallucinator Agent Configuration
HALLUCINATOR_CREATIVITY=0.8
HALLUCINATOR_AUTO=false

# Application Configuration
LOG_LEVEL=INFO
ENVIRONMENT=development
